# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYMENT GATEWAY (Auto-Push with Merchant Till Auto-Routing)
PAYMENT_GATEWAY_BASE_URL="https://api.paymentgateway.com/v1"
PAYMENT_GATEWAY_API_KEY=""



# Comma-separated HTTPS origins allowed to call the deployed API from a browser.
# Capacitor Android's https://localhost origin is allowed by the server automatically.
CORS_ALLOWED_ORIGINS="https://your-web-app.example"

# Frontend build-time setting: deployed HTTPS Express backend origin, without /api.
# Set as a VITE_API_BASE_URL environment variable when building the Android APK.
VITE_API_BASE_URL="https://your-api.example"
